{
  "manifest_version": 3,
  "name": "Instagram Real-time Mic & Audio Controller",
  "version": "1.4.0",
  "description": "ควบคุมเปิด-ปิดไมโครโฟนและหูฟังบน Instagram แบบเรียลไทม์ พร้อมเชื่อมต่อปุ่มลัด C++",
  "key": "",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://instagram.com/*"
      ],
      "all_frames": true,
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://instagram.com/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
